# Python-generated files
# Cython writes the C file of the kernel at build time; it never belongs in git (scripts/check_distributions.py)
src/**/*.c
*.so
*.pyd
wheelhouse/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
wheels/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.hypothesis/
htmlcov/

# Virtual environments
.venv/
venv/

# Env / secrets
.env
.env.*
!.env.example

# Claude Code local state
.claude/settings.local.json
.claude/worktrees/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp
.mutation/

# Built documentation
site/

# Lean (proofs/)
proofs/.lake/
proofs/papers/**/*.pdf
# Papers compiled by scripts/build_docs.py
docs/proofs/
